# Data provider: eod2 (public NSE end-of-day mirror, prototype only) or pmsec (your price service, VPC only)
PRICE_PROVIDER=eod2
# PRICE_SERVICE_URL=http://172.31.19.132:8766
# PRICE_INTERNAL_KEY=   # set from your secret store; never commit it

# Reasoner: auto (Claude when ANTHROPIC_API_KEY is set, otherwise deterministic fallback), claude, fallback
TAVIEW_REASONER=auto
# ANTHROPIC_API_KEY=
TAVIEW_MODEL=claude-opus-5-5
TAVIEW_SAMPLES=3
TAVIEW_FALLBACKS=0        # 1 enables server-side refusal fallbacks (beta header) on the Claude call

# Storage and caching
TAVIEW_DATA_DIR=./data
TAVIEW_VIEW_TTL_HOURS=20  # serve a stored view this old before recomputing
TAVIEW_OFFLINE=0          # eod2 only: 1 = never fetch, use the on-disk cache
# TAVIEW_CHROMIUM=        # path to a Chromium binary for card rendering, if Playwright's default is missing
